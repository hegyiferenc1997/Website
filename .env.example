# Minta a beállításokhoz. Másold le .env.local néven a projekt gyökerébe, és töltsd ki.
# A .env.local nem kerül fel a GitHubra (titkos kulcsok vannak benne).
# Helyi fejlesztéshez (pnpm dev) egyik sem kötelező: üresen is működik az e-mail + jelszó belépés.

# Saját Postgres adatbázis (pl. Neon). Ha üres, a beépített PGlite fut.
DATABASE_URL=

# A bejelentkezés titkos kulcsa. Élesben kötelező! Generálás:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=
# Az oldal címe (élesben pl. https://engineeringmaxxing.hu). Helyben: http://localhost:3000
BETTER_AUTH_URL=

# Google belépés (lásd docs/bejelentkezes.md)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Apple belépés (lásd docs/bejelentkezes.md)
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=

# Fizetési szolgáltató (lásd docs/fizetes.md). Üresen vagy „mock”-kal próba-fizetés fut, valódi terhelés nélkül.
PAYMENT_PROVIDER=

# Admin fiókok e-mail címei vesszővel elválasztva (pl. a te címed). Ezeknél a fióknál a fiók menüben
# megjelenik a „God mode” kapcsoló: bekapcsolva minden lecke nyitva, sorrendi zárolás és fizetés nélkül.
# E-mail cím alapján működik, így e-mail + jelszavas és (beállítás után) Google-belépéssel is.
ADMIN_EMAILS=
